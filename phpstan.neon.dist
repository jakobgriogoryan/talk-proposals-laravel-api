includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    level: 5
    phpVersion: 80200
    stubFiles:
        - stubs/Algolia4Engine.stub
        - stubs/Seeder.stub
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
    tmpDir: storage/framework/cache/phpstan
